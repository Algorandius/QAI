# ============================================================
#  QQ 机器人主配置文件
#  改完本文件后需要重启机器人（python bot.py）才会生效
# ============================================================

# ===== NoneBot2 框架基础 =====
ENVIRONMENT=dev
DRIVER=~fastapi+~websockets+~httpx
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# 命令前缀：/ping、!ping 都能触发
COMMAND_START=["/", "!", "！"]

# ===== OneBot 连接 =====
# ⚠️ 这个 Token 必须和 NapCat WebUI 里「反向 WebSocket」填的 Token 完全一致，否则连不上
ONEBOT_ACCESS_TOKEN=change-me

# ===== 权限与范围 =====
# 管理员 QQ 号，多个用英文逗号分隔（/ban、/groups、/status 等敏感命令需要）
BOT_ADMIN_QQ=
# 允许机器人工作的群号白名单，多个用英文逗号分隔。留空 = 所有群都响应（体验阶段建议填上）
ALLOWED_GROUPS=

# ===== AI 对话行为 =====
# 群内触发方式：at（@机器人）/ prefix（前缀触发）/ off（关闭群内 AI）
AI_GROUP_TRIGGER=at
AI_PREFIX=ai
# 自主接话总开关：false = 只在被 @ 时回复，永不主动接话
# （也可用 /接话 开 / /接话 关 临时切换，重启后回到这里的值）
AI_GROUP_AUTO=true
# 群聊"自主接话"：没被 @ 时也按概率自己插一句（0=关闭，只在被 @ 时回）
# 示例人设人设：少而精，不追着每条都回，所以给得很低
AI_GROUP_AUTO_PROB=0.12
# 两次自主接话之间的最小间隔（秒），防止群里连续插话刷屏
AI_GROUP_AUTO_COOLDOWN=90
# 被叫到这些名字时必回（多个用英文逗号分隔）
AI_NAME_ALIASES=小满,小助手
# 自主接话诊断日志：每条群消息打一行，说明"接了/没接、为什么"。
# 排查"它怎么不接话"时开着，看完嫌吵就设 false
AI_AUTO_DEBUG=true
# 政治/时政话题硬拦截：命中就直接不接（人设底线，程序层兜一道）
AI_POLITICS_GUARD=true
# 私聊是否直接当 AI 对话处理
AI_PRIVATE=true
# 连续对话保留轮数（1 轮 = 用户 1 条 + 机器人 1 条）；重启后记忆从 data/state.json 恢复
AI_HISTORY_TURNS=100
# 同一用户在同一群的冷却秒数，防刷屏
AI_COOLDOWN_SEC=5
# 单轮回复「整体」最大字符数（示例人设人设：一条 1~8 字、最多 2~3 条，所以整体给得很小）
AI_MAX_CHARS=60
# 单条消息最多几个字，超出就硬切（人设要求一条只发一行，别写成小作文）
AI_MSG_MAX_CHARS=20
# 单轮最多连发几条消息（防止刷屏；人设是偶尔连发两三条）
AI_MAX_MSGS=3
# 是否模拟真人节奏（思考停顿 + 分句 + 打字节奏）
AI_HUMANIZE=true
# 收到消息后先"愣一下"再回，秒数在这个区间随机取（太小会秒回，很假）
AI_THINK_MIN=1.2
AI_THINK_MAX=3.5
# 打字速度，字/秒。越小越慢越像真人（示例人设打字很慢，所以给得偏低）
AI_TYPE_CPS=8
# 连发两条消息之间的停顿（秒，在这个区间随机取）。她是"想起来再补一句"，不用太长
AI_GAP_MIN=3
AI_GAP_MAX=8
# 对方「引用某条消息」提问时，机器人的回复也带上引用
AI_QUOTE_ON_REPLY=true
# 主动引用：对方没引用时，机器人也有概率主动用 QQ「引用」框引用对方这条消息（更有人味）
AI_QUOTE_PROACTIVE=true
# 主动引用概率（0~1）：人设要求"不要每条都引"，所以给得很低
AI_QUOTE_PROB=0.2
# 主动引用更早的历史消息（机器人判断该引用你哪条旧消息，用 [引N] 标记；false 关闭）
AI_QUOTE_HIST=true

# ===== 记忆 / 心情 / 表情（想法 1·2·4·6）=====
# 历史压缩：把最旧的对话压缩成摘要，省 token 同时保留长期记忆（false 则 50 轮原文全发，更贵）
AI_COMPRESS=true
# 压缩后保留最近 N 轮原文（更早的卷进摘要）
AI_COMPRESS_KEEP_TURNS=12
# 每超出多少条触发一次压缩
AI_COMPRESS_TRIGGER=8
# 心情系统开关（根据对方语气调整机器人语气）
AI_MOOD=true
# 好感度系统（按群成员记录：越聊越熟、被夸涨、被骂掉；/好感 查看）
AI_AFFINITY=true

# ===== 长期记忆（模型主动记下值得跨天保留的事）=====
# 总开关：关掉后模型看不到记忆工具，也不会自动把记忆注入 prompt
AI_LONGTERM=true
# 每个场景（群/私聊）最多保留多少条，超出淘汰最旧
AI_LONGTERM_MAX=200
# 每轮自动把最近几条“你记得的事”注入 system；0 = 不自动带，只靠 memory_query 查
AI_LONGTERM_RECALL=5

# ===== 自动清理（防止场景/对话无限增长）=====
# 对话记忆保留天数：单条超期删除；整段场景超期没聊天，连摘要/心情/好感度一起清。0 = 关闭
AI_MEMORY_TTL_DAYS=30
# 长期记忆保留天数：0 = 永久保留（推荐）；设 180 就是半年
AI_LONGTERM_TTL_DAYS=0
# 聊天日志 data/chatlog.jsonl 保留天数：0 = 不裁剪
AI_CHATLOG_KEEP_DAYS=30
# 后台清理间隔（小时），最小 1
AI_MEMORY_CLEAN_INTERVAL_HOURS=6
# 主动发 QQ 小黄脸开关 + 概率 + 冷却（秒）；示例人设少用表情，所以给得很低
AI_STICKER=true
AI_STICKER_PROB=0.08
AI_STICKER_COOLDOWN=60

# ===== 发图（模型自主判断，走 DeepSeek Tool Calls）=====
# 总开关
AI_IMAGE_SEND=true
# 图源：
#   360  = 免 Key、中文搜索、国内快；但图片版权不可控，只适合自己群里玩，别商用
#   key  = 只用下面 Pexels/Pixabay/Unsplash，版权干净（免费商用）但需要注册 Key
#   auto = 360 优先，失败再用 key 源
AI_IMAGE_SOURCE=360
# 单轮最多发几张图（模型可能一次要好几张，限制一下别刷屏）
AI_IMAGE_MAX_PER_TURN=1
# 主动配图概率：不是被明确要求时，只有这个概率才允许发图（调小 = 更少发图）
AI_IMAGE_TRIGGER_PROB=0.2
# 两次发图的最小间隔（秒）
AI_IMAGE_COOLDOWN=90
# 允许机器人发你 QQ 收藏的表情包（NapCat 的 fetch_custom_face 接口；/表情包 命令也可手动触发）
AI_CUSTOM_STICKER=true
# 模型自主发收藏表情的概率 + 冷却（独立于图片，不受 AI_IMAGE_* 影响）
AI_CUSTOM_STICKER_PROB=0.25
AI_CUSTOM_STICKER_COOLDOWN=60
# 把"表情库里有哪些类别"告诉模型（建库后才有内容；关掉可省一点 prompt）
AI_STICKER_CATALOG=true
# 主动补表情：每轮说完话后，程序自己按概率追加一个表情包（不靠模型决定，所以更稳）
# 人设要求"普通闲聊大约每 4~6 轮来一张"，所以概率低 + 冷却长
AI_AUTO_STICKER=true
AI_AUTO_STICKER_PROB=0.18
AI_AUTO_STICKER_COOLDOWN=100
# 主动戳一拍（QQ 的「拍一拍」，走 NapCat 的 group_poke）：模型自己决定要不要戳，
# 每次戳完至少隔这么久（秒）。0 = 不限制（不推荐）
AI_POKE=true
AI_POKE_COOLDOWN=90
# —— 以下 Key 仅 AI_IMAGE_SOURCE=key/auto 时才需要 ——
# Pixabay 免费 Key：https://pixabay.com/api/docs/ 注册登录后页面顶部即是
PIXABAY_API_KEY=
# Pexels 自 2026-09-30 起已暂停发放新 Key（老 Key 仍可用）
PEXELS_API_KEY=
# Unsplash：https://unsplash.com/developers 创建 App 后取 Access Key
UNSPLASH_ACCESS_KEY=
# 单张图片最大 MB（超过就跳过）
AI_IMAGE_MAX_MB=10

# ===== 联网搜索（DeepSeek Search / Fetch，2026-10-17 上线的官方接口）=====
# 开关：关掉后模型看不到搜索工具，也不会产生搜索费用
AI_WEB_TOOL=true
# 每轮对话最多查几次（含 search 与 fetch），防止模型反复查、也防止烧钱
AI_WEB_MAX_SEARCH=3
# 单次搜索结果拼给模型的字符上限
AI_WEB_RESULT_CHARS=1200
# fetch 抓到的网页正文塞给模型的字符上限（网页常几万字，不截会炸上下文）
AI_WEB_FETCH_CHARS=3000
AI_WEB_TIMEOUT=30
# 计费：每 1000 次成功请求 5 元 ≈ 0.005 元/次。日常聊天很少触发，忽略不计。

# ===== 掉线回归播报（想法 9）=====
# 重连后在哪些群播报"我回来了"。留空则回退到 ALLOWED_GROUPS；都为空则静默
AI_WELCOME_GROUPS=

# ===== Web 管理面板（想法 7）=====
# 浏览器打开 http://127.0.0.1:8081/ 查看状态、改人设、清记忆、看日志
WEB_PANEL=true
WEB_PANEL_PORT=8081

# ===== 桌面控制中心 =====
# 启动器控制服务端口（浏览器/应用窗口访问 http://127.0.0.1:8082/）
LAUNCHER_PORT=8082
# 打开控制中心时自动拉起机器人（false = 只管理，不自动启动）
LAUNCHER_AUTO_START=true
# NapCat 目录（launcher-win10.bat 所在）；只在控制中心点「启动 NapCat」时用
NAPCAT_DIR=
# 打开控制中心时是否自动拉起 NapCat（会弹 UAC；默认 false）
NAPCAT_AUTO_START=false
# 探测 NapCat WebUI 的端口
NAPCAT_PORT=6099

# 图片识别（多模态）。DeepSeek V4.1 Flash（deepseek-flash）原生支持识图，直接开 true 就行
# 图片会先下载再转 base64 内联发出（QQ 图片链接常带鉴权，让 DeepSeek 直接拉容易失败）
# 单张图最多折算 384 tokens，按文本价计费，很便宜
AI_VISION=true
# 识图后允许模型联网核对图片中的人物/地点/事件/商品等信息
AI_VISION_SEARCH=true
# 一次最多识几张图
AI_VISION_MAX_IMAGES=2

# ===== 大模型（OpenAI 兼容协议：DeepSeek / 智谱 / 硅基流动 / 本地 Ollama 均可）=====
#
# 当前用的是 DeepSeek V4.1 Flash（原生多模态，能看图）
# ⚠️ 2026-09-10 起官方把模型名改成了 deepseek-flash；旧的 deepseek-v4-flash /
#    deepseek-v4-flash-vision-exp 已下线，目前只是被暂时路由过来，建议直接用新名。
#    重度推理可选 deepseek-v4-pro；deepseek-chat / deepseek-reasoner 早已停用。
# 申请：https://platform.deepseek.com/ → 注册 → 充值 → API Keys → 新建
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
#
# —— 想换成免费的智谱 GLM-4-Flash（永久免费不限量），把上面 3 行换成下面 2 行 ——
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# 温度越高越跳脱，拟人聊天建议 0.85~1.0
LLM_TEMPERATURE=0.95

